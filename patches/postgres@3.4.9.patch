--- a/cjs/src/index.js
+++ b/cjs/src/index.js
@@ -452,7 +452,12 @@ function parseOptions(a, b) {
     idle_timeout    : null,
     connect_timeout : 30,
     max_lifetime    : max_lifetime,
-    max_pipeline    : 100,
+    // PATCHED: 0, not 100. Ten or more pipelined statements on one connection
+    // hang Supabase's transaction pooler (never answered, no error). Only
+    // statements that skip the describe round trip pipeline at all, so the
+    // describe-first patch in connection.js would have made every concurrent
+    // parameterized batch hang; a bare `select 1` batch always did.
+    max_pipeline    : 0,
     backoff         : backoff,
     keep_alive      : 60,
     prepare         : true,
