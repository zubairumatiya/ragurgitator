{
  "name": "rag-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test '**/*.test.ts'",
    "vault:check": "node --env-file=.env.local --import tsx scripts/vault-check.ts",
    "rls:check": "node --env-file=.env.local --import tsx scripts/rls-check.ts",
    "cascade:check": "node --env-file=.env.local --import tsx scripts/cascade-check.ts",
    "guard": "node --import tsx scripts/guards.ts",
    "guard:trace": "node --import tsx scripts/trace-guard.ts",
    "smoke": "node --import tsx scripts/smoke-deploy.ts",
    "jobs:smoke": "node --env-file=.env.local --import tsx scripts/jobs-smoke.ts",
    "resume:7b": "node --env-file=.env.local --import tsx scripts/resume-7b.ts",
    "phase8": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/phase8.ts",
    "probe:eligibility": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/probe-eligibility.ts",
  "f1": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f1-negatives.ts",
    "f2": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f2-floor.ts",
    "f3": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f3-pairs.ts",
    "f3:sweep": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f3-sweep.ts",
    "f6": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f6-order.ts",
    "f7": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/f7-prior.ts",
    "demo:snapshot": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/demo-snapshot.ts",
    "cache:equiv": "node --env-file=.env.local --import ./scripts/serverOnlyShim.cjs --import tsx scripts/cache-probe-equiv.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "itest": "node --conditions=react-server --import tsx --import ./test/support/env.ts --test --test-concurrency=1 \"test/integration/**/*.itest.ts\"",
    "itest:up": "node --import tsx scripts/itest-up.ts",
    "itest:down": "docker rm -f rag-itest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-keys": "^4.10.2",
