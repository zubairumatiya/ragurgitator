# Copy this file to ".env.local" and fill in real values. Never commit .env.local.
# Next.js loads .env.local automatically. These are server-only (no NEXT_PUBLIC_
# prefix), so they never reach the browser bundle.

# Postgres connection strings — BOTH are required, and they are different roles.
# The database needs the pgvector extension (e.g. a free Supabase project works).
#
# DATABASE_URL connects as `postgres`, which bypasses RLS. Only three callers use
# it: account deletion, migrations, and the cross-tenant backfill script.
#
# RAG_APP_DATABASE_URL connects as `rag_app` (NOBYPASSRLS, created in
# migrations/0051_rls.sql) and is what the whole store layer runs as, so the
# policies actually bite. There is deliberately no fallback to DATABASE_URL: a
# missing value throws at startup rather than silently serving every tenant's
# rows to everyone.
#
# On a serverless host point both at Supabase's TRANSACTION pooler (port 6543).
DATABASE_URL=
RAG_APP_DATABASE_URL=

# --- Supabase Auth (user accounts) ------------------------------------------
# From the Supabase dashboard → Project Settings → API Keys. Same project as
# DATABASE_URL above.
#
# Use the PUBLISHABLE key (sb_publishable_…), not the legacy `anon` JWT: Supabase
# replaced anon/service_role with publishable/secret keys, and the legacy pair is
# scheduled for deletion in late 2026.
# See https://github.com/orgs/supabase/discussions/29260
#
# NEXT_PUBLIC_ on purpose: the publishable key identifies the project and carries
# no authority of its own — access is governed by the signed-in user's JWT — so
# it is designed to ship to the browser. Never put the sb_secret_… key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin used to build the email-confirmation link (app/auth/actions.ts). Must
# also be listed under Authentication → URL Configuration → Redirect URLs in
# Supabase, or confirmation links fall back to the project's Site URL.
# Defaults to http://localhost:3002 (the dev port) when unset.
NEXT_PUBLIC_SITE_URL=

# --- Provider API keys: THERE ARE NONE HERE ANY MORE -------------------------
# ANTHROPIC_API_KEY, VOYAGE_API_KEY, OPENAI_API_KEY and COHERE_API_KEY used to
# live here. Under strict BYOK (docs/user-accounts-plan.md §5) every provider
# call is billed to the SIGNED-IN USER's own key, which they add on the /account
# page and which is stored under envelope encryption (never in an env var, never
# in plaintext). Setting them here now does nothing — no code reads them.
#
# The deployment holds no provider credential at all. That is the point: a server
# key is a shared bill and a shared blast radius, and with one it is impossible
# to answer "whose key paid for this call".
#
# Consequence worth knowing before you start: your own eval, autotune, judging
# and calibration tooling all run on provider calls, so the first account you
# sign up must add real keys through the UI before any of it works.

# Local transformers.js models (mxbai-embed-large, bge-m3). Set to any non-empty
# value (e.g. 1) to enable — they need no key, but they download hundreds of MB
# of weights on first use and won't run on serverless hosts, so leave this unset
# in web deployments.
LOCAL_EMBEDDINGS=

# --- Azure Key Vault (user accounts / BYOK) ---------------------------------
# Wraps the per-secret data keys that encrypt each user's provider API keys
# (lib/crypto/azureKeyVault.ts, docs/user-accounts-plan.md §4). Use a Key Vault
# *key* (not a secret) so the KEK never leaves the vault; a software-protected
# RSA key on the standard tier has no monthly per-key charge.
#
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_KEY_NAME=

# How the APP authenticates to Azure — unrelated to how your USERS authenticate
# to this app (that's Supabase Auth). One machine identity serves every user.
#
# Locally: nothing to set. DefaultAzureCredential falls back to your `az login`
# session. Grant yourself "Key Vault Crypto Officer" on the vault.
#
# On Vercel: managed identity is NOT available (it's Azure-compute only), so use
# OIDC federation — Vercel mints a short-lived token per invocation and Azure
# exchanges it, leaving no long-lived secret to store or rotate. Set the two vars
# below in the Vercel dashboard and DELIBERATELY NOT a client secret. Grant the
# app registration "Key Vault Crypto User" (wrap/unwrap only — it never needs to
# create or delete keys). Guide: https://vercel.com/docs/oidc/azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
